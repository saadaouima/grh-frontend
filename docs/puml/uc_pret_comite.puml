@startuml uc_pret_comite
title Diagramme de cas d'utilisation - Demande de pret et circuit DG / Comite

skinparam usecaseBorderColor #2C5F8A
skinparam usecaseBackgroundColor #EAF2FB
skinparam actorBorderColor #1A3A5C
skinparam nodesep 70
skinparam ranksep 60

top to bottom direction

actor "Employe"          as emp
actor "Chef"             as chef
actor "Admin RH"         as admin
actor "Comite"           as comite
actor "Directeur General" as dg

rectangle "Synapse - Module Prets et Credits" {

  usecase "Deposer une demande de pret" as UC1
  usecase "Valider la demande (Chef)"   as UC2
  usecase "Instruire le dossier (RH)"   as UC3
  usecase "Soumettre au comite"         as UC4
  usecase "Voter sur le dossier"        as UC5
  usecase "Approuver le pret (DG)"      as UC6
  usecase "Finaliser et notifier"       as UC7
  usecase "Rejeter a tout niveau"       as UC8
  usecase "Notifier l'employe"          as UC9
  usecase "Consulter ses prets"         as UC10
}

emp    --> UC1
emp    --> UC10
chef   --> UC2
admin  --> UC3
admin  --> UC7
comite --> UC5
dg     --> UC6

UC1 ..> UC9 : <<include>>
UC2 ..> UC9 : <<include>>
UC7 ..> UC9 : <<include>>

UC4 ..> UC3 : <<extend>>\n[condition : commission requise]
UC5 ..> UC4 : <<extend>>\n[condition : dossier soumis au comite]
UC8 ..> UC2 : <<extend>>\n[condition : decision = REJET]
UC8 ..> UC3 : <<extend>>\n[condition : decision = REJET]
UC8 ..> UC6 : <<extend>>\n[condition : decision = REJET]

@enduml
